{
  "name": "flowgen",
  "version": "0.1.0",
  "description": "MD-to-HTML flowchart generator (Account Recovery Flow visual language)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "flowgen": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:editor": "esbuild src/editor-entry.ts --bundle --format=iife --platform=browser --global-name=Flowgen --outfile=editor.bundle.js --target=es2020",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "parse": "tsx src/cli.ts",
    "render": "tsx src/cli.ts test/fixtures/recovery-flow.md --html -o recovery-flow.html",
    "editor": "npm run build:editor && echo 'open editor.html in your browser'"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
